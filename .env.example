# ============================================
# FFXIV Static Planner - Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.

# ── Docker PostgreSQL ─────────────────────────
# Used by docker-compose to create the database container.
POSTGRES_DB=ffxiv_planner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Database (Backend) ───────────────────────
# For Docker:     jdbc:postgresql://postgres:5432/ffxiv_planner (service name as host)
# For bare-metal: jdbc:postgresql://localhost:5432/ffxiv_planner
DATABASE_URL=jdbc:postgresql://localhost:5432/ffxiv_planner
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# ── Redis ───────────────────────────────────
# For Docker:     redis (service name as host)
# For bare-metal: localhost
REDIS_HOST=localhost
REDIS_PORT=6379
# Required in production. Generate with: openssl rand -base64 32
REDIS_PASSWORD=

# ── JWT ─────────────────────────────────────
# Min 32 characters (256 bits) for HS256. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000

# ── OAuth - Google ──────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth - Discord ─────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Stripe ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── XIVAPI / Lodestone ─────────────────────
XIVAPI_KEY=

# ── Mail (SMTP) ────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Frontend ──────────────────────────────────
# Base URL for API calls from the browser.
# For Docker prod (via Nginx): /api/v1
# For bare-metal dev:          http://localhost:8080/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws
