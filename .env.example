# ============================================
# FFXIV Static Planner - Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.

# ── Database (PostgreSQL) ───────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/ffxiv_planner
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# ── Redis ───────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ─────────────────────────────────────
JWT_SECRET=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000

# ── OAuth - Google ──────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth - Discord ─────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Stripe ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── XIVAPI / Lodestone ─────────────────────
XIVAPI_KEY=

# ── Mail (SMTP) ────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
